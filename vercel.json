{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "env": {
    "REACT_APP_BACKEND_URL": "https://salome-portfolio-api.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://salome-portfolio-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
